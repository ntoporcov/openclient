{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "comment": "DSH app display name; do not translate the product name.",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "OpenClient" } },
        "it": { "stringUnit": { "state": "translated", "value": "OpenClient" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "OpenClient" } }
      }
    },
    "CFBundleName": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "OpenClient" } },
        "it": { "stringUnit": { "state": "translated", "value": "OpenClient" } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "OpenClient" } }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "OpenClient connects to your DSH server on your local network." } },
        "it": { "stringUnit": { "state": "translated", "value": "OpenClient si connette al tuo server DSH sulla tua rete locale." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "O OpenClient se conecta ao seu servidor DSH pela rede local." } }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "OpenClient uses the microphone for dictation and voice conversations." } },
        "it": { "stringUnit": { "state": "translated", "value": "OpenClient usa il microfono per la dettatura e le conversazioni vocali." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "O OpenClient usa o microfone para ditado e conversas por voz." } }
      }
    },
    "NSPersonalVoiceUsageDescription": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "OpenClient uses your Personal Voice to read AI responses aloud when you select it." } },
        "it": { "stringUnit": { "state": "translated", "value": "OpenClient usa la tua Voce personale per leggere ad alta voce le risposte dell'IA quando la selezioni." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "O OpenClient usa sua Voz Pessoal para ler as respostas da IA em voz alta quando você a seleciona." } }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "OpenClient uses your photo library to show recent photos and attach selected images to messages." } },
        "it": { "stringUnit": { "state": "translated", "value": "OpenClient usa la tua libreria foto per mostrare foto recenti e allegare le immagini selezionate ai messaggi." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "O OpenClient usa sua fototeca para mostrar fotos recentes e anexar as imagens selecionadas às mensagens." } }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "OpenClient uses speech recognition to transcribe dictation and voice conversations." } },
        "it": { "stringUnit": { "state": "translated", "value": "OpenClient usa il riconoscimento vocale per trascrivere la dettatura e le conversazioni vocali." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "O OpenClient usa o reconhecimento de fala para transcrever ditados e conversas por voz." } }
      }
    }
  },
  "version": "1.0"
}
