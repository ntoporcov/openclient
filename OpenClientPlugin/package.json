{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@openclient-ios/opencode-plugin",
  "version": "0.2.0",
  "description": "Connect OpenCode to the OpenClient iOS app for native tools, visuals, and in-app browser automation.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "openclient-notify": "./dist/notifications/src/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntoporcov/openclient.git",
    "directory": "OpenClientPlugin"
  },
  "homepage": "https://github.com/ntoporcov/openclient#readme",
  "bugs": {
    "url": "https://github.com/ntoporcov/openclient/issues"
  },
  "author": "Nic Toporcov",
  "license": "PolyForm-Noncommercial-1.0.0",
  "keywords": [
    "opencode",
    "openclient",
    "ios",
    "plugin",
    "ai",
    "browser-automation"
  ],
  "scripts": {
    "build": "tsc && npm run build:notifications",
    "build:notifications": "node scripts/build-notifications.mjs",
    "check": "tsc --noEmit && tsc --project tsconfig.test.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "distribute": "NPM_TOKEN=\"$(security find-generic-password -s openclient-npm-publish -w)\" npm publish",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run clean && npm run check && npm test && npm run build",
    "test": "npm run build:notifications && bun test"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.5",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "24.12.2",
    "@types/web-push": "3.6.4",
    "bun": "1.3.14",
    "typescript": "5.8.2"
  }
}
