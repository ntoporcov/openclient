            "state" : "translated",
            "value" : "tra %1$lld%2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "em %1$lld%2$@"
          }
        }
      }
    },
    "Inferring" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
