    },
    "Without HTTPS, someone controlling the network can impersonate the server and recover this credential." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Without HTTPS, someone controlling the network can impersonate the server and recover this credential."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza HTTPS, chi controlla la rete può impersonare il server e recuperare questa credenziale."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem HTTPS, alguém que controla a rede pode se passar pelo servidor e recuperar esta credencial."
          }
        }
      }
    },
    "Working" : {
