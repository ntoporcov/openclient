    "Location changed" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Location changed" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Posizione modificata" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Local alterado" } } } },
    "Model changed" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Model changed" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Modello modificato" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Modelo alterado" } } } },
    "Add OC Notify to your Home Screen. This gives the web app permission to receive Web Push on iPhone." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Add OC Notify to your Home Screen. This gives the web app permission to receive Web Push on iPhone." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Aggiungi OC Notify alla schermata Home. In questo modo l’app web può ricevere notifiche Web Push su iPhone." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Adicione o OC Notify à Tela de Início. Isso permite que o app web receba notificações Web Push no iPhone." } } } },
    "Alerts contain no chat body or OpenCode password. They carry only the event kind, a validated route, and bounded project or session labels. Those labels can appear on your Lock Screen." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Alerts contain no chat body or OpenCode password. They carry only the event kind, a validated route, and bounded project or session labels. Those labels can appear on your Lock Screen." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Gli avvisi non contengono il testo delle chat né la password di OpenCode. Includono solo il tipo di evento, un percorso convalidato ed etichette limitate di progetto o sessione. Queste etichette possono apparire sulla schermata di blocco." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Os alertas não contêm o conteúdo dos chats nem a senha do OpenCode. Eles levam apenas o tipo de evento, uma rota validada e rótulos limitados de projeto ou sessão. Esses rótulos podem aparecer na Tela Bloqueada." } } } },
    "Also in this release" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Also in this release" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Anche in questa versione" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Também nesta versão" } } } },
    "Apple Web Push" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Apple Web Push" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Web Push di Apple" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Web Push da Apple" } } } },
    "Built to reveal less" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Built to reveal less" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Progettato per rivelare meno" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Feito para revelar menos" } } } },
    "Creates a minimal alert" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Creates a minimal alert" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Crea un avviso minimo" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Cria um alerta mínimo" } } } },
    "Creates alert" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Creates alert" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Crea l’avviso" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Cria o alerta" } } } },
    "Encrypted delivery" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Encrypted delivery" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Consegna crittografata" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Entrega criptografada" } } } },
    "Fixes across projects, sessions, tools, and live updates make connecting to OpenCode v2 more reliable." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Fixes across projects, sessions, tools, and live updates make connecting to OpenCode v2 more reliable." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Le correzioni a progetti, sessioni, strumenti e aggiornamenti in tempo reale rendono più affidabile la connessione a OpenCode v2." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Correções em projetos, sessões, ferramentas e atualizações ao vivo tornam a conexão com o OpenCode v2 mais confiável." } } } },
    "HOW THE PWA FITS IN" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "HOW THE PWA FITS IN" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "IL RUOLO DELLA PWA" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "COMO O PWA SE ENCAIXA" } } } },
    "NO OPENCLIENT CLOUD" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "NO OPENCLIENT CLOUD" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "NESSUN CLOUD OPENCLIENT" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "SEM NUVEM DO OPENCLIENT" } } } },
    "No OpenClient cloud. Your OpenCode host creates a minimal alert, Apple Web Push delivers it encrypted, and OC Notify receives it on your iPhone." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "No OpenClient cloud. Your OpenCode host creates a minimal alert, Apple Web Push delivers it encrypted, and OC Notify receives it on your iPhone." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Nessun cloud OpenClient. Il tuo host OpenCode crea un avviso minimo, Web Push di Apple lo consegna in forma crittografata e OC Notify lo riceve sul tuo iPhone." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Sem nuvem do OpenClient. Seu host OpenCode cria um alerta mínimo, o Web Push da Apple o entrega criptografado e o OC Notify o recebe no seu iPhone." } } } },
    "OC Notify brings Web Push to OpenClient, with no hosted OpenClient relay between your OpenCode host and your iPhone." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "OC Notify brings Web Push to OpenClient, with no hosted OpenClient relay between your OpenCode host and your iPhone." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "OC Notify porta Web Push in OpenClient, senza alcun relay OpenClient ospitato tra il tuo host OpenCode e il tuo iPhone." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O OC Notify traz Web Push ao OpenClient, sem um relay hospedado do OpenClient entre seu host OpenCode e seu iPhone." } } } },
    "OC Notify opens OpenClient" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "OC Notify opens OpenClient" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "OC Notify apre OpenClient" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "OC Notify abre o OpenClient" } } } },
    "OpenCode host" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "OpenCode host" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Host OpenCode" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Host OpenCode" } } } },
    "OpenCode v2, steadier" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "OpenCode v2, steadier" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "OpenCode v2, più stabile" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "OpenCode v2, mais estável" } } } },
    "Private push, straight to you" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Private push, straight to you" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Push privato, direttamente a te" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Push privado, direto para você" } } } },
    "Setup becomes available here when OpenClient is connected to a compatible plugin with OC Notify enabled." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Setup becomes available here when OpenClient is connected to a compatible plugin with OC Notify enabled." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "La configurazione sarà disponibile qui quando OpenClient è connesso a un plugin compatibile con OC Notify abilitato." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A configuração ficará disponível aqui quando o OpenClient estiver conectado a um plugin compatível com o OC Notify ativado." } } } },
    "Tap the notification and OC Notify hands off to the matching session in OpenClient. Enable Try Auto-Open to make the redirect automatic when iOS allows it." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Tap the notification and OC Notify hands off to the matching session in OpenClient. Enable Try Auto-Open to make the redirect automatic when iOS allows it." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Tocca la notifica e OC Notify passa alla sessione corrispondente in OpenClient. Abilita Prova apertura automatica per rendere automatico il reindirizzamento quando iOS lo consente." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Toque na notificação e o OC Notify abre a sessão correspondente no OpenClient. Ative Tentar Abertura Automática para redirecionar automaticamente quando o iOS permitir." } } } },
    "Web Push, without the middleman" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Web Push, without the middleman" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Web Push, senza intermediari" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Web Push, sem intermediários" } } } },
    "Your OpenCode host turns activity into a minimal encrypted alert and sends it directly through Apple’s Web Push service." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your OpenCode host turns activity into a minimal encrypted alert and sends it directly through Apple’s Web Push service." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Il tuo host OpenCode trasforma l’attività in un avviso minimo crittografato e lo invia direttamente tramite il servizio Web Push di Apple." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Seu host OpenCode transforma a atividade em um alerta mínimo criptografado e o envia diretamente pelo serviço Web Push da Apple." } } } },
    "Your chat messages and raw OpenCode events never go to an OpenClient server or notification relay." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your chat messages and raw OpenCode events never go to an OpenClient server or notification relay." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "I messaggi delle chat e gli eventi OpenCode non elaborati non vengono mai inviati a un server OpenClient o a un relay di notifiche." } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Suas mensagens de chat e eventos brutos do OpenCode nunca vão para um servidor do OpenClient nem para um relay de notificações." } } } },
    "Your iPhone" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Your iPhone" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Il tuo iPhone" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Seu iPhone" } } } },
