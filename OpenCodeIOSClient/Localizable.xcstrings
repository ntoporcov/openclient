    "Configure commands as quick Actions. Sessions stay on the server. Successful runs are hidden locally and can be restored from Action Run History." : {
      "comment" : "Project Actions explanation. Hidden locally does not mean archived or deleted on the server.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure commands as quick Actions. Sessions stay on the server. Successful runs are hidden locally and can be restored from Action Run History."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura i comandi come azioni rapide. Le sessioni restano sul server. Le esecuzioni riuscite vengono nascoste localmente e possono essere ripristinate dalla Cronologia delle esecuzioni delle azioni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configure comandos como ações rápidas. As sessões permanecem no servidor. Execuções bem-sucedidas ficam ocultas localmente e podem ser restauradas pelo Histórico de execução de ações."
          }
        }
      }
    },
    "Configure the OC Notify HTTPS public origin on the OpenCode host, then reconnect." : {
      "localizations" : {
        "en" : {
