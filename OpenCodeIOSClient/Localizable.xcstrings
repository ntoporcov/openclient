    "Give me a moment.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só um momento."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dammi un momento."
          }
        }
      }
    },
    "I'm thinking that through.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estou pensando nisso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sto riflettendo."
          }
        }
      }
    },
    "Hmm, let me think about that.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hmm, deixe-me pensar sobre isso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mmh, fammi pensare."
          }
        }
      }
    },
    "Let me check on that.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe-me verificar isso."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fammi controllare."
          }
        }
      }
    },
    "Let me see what I can find.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe-me ver o que encontro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fammi vedere cosa riesco a trovare."
          }
        }
      }
    },
    "Let me take a closer look.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe-me analisar mais de perto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fammi dare un'occhiata più da vicino."
          }
        }
      }
    },
    "Let me work through that.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe-me pensar nisso com calma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fammi ragionare su questo."
          }
        }
