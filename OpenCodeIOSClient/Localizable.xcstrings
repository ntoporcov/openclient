      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Voz da conversa"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Voce della conversazione"
          }
        }
      }
    },
    "Create a Personal Voice in Settings > Accessibility > Personal Voice, then allow OpenClient to use it here.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma Voz Pessoal em Ajustes > Acessibilidade > Voz Pessoal e permita que o OpenClient a use aqui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una Voce personale in Impostazioni > Accessibilità > Voce personale, quindi consenti a OpenClient di usarla qui."
          }
        }
      }
    },
    "Download more voices in Settings > Accessibility > Read & Speak (or Spoken Content) > Voices. OpenClient updates this list automatically after a voice downloads.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe mais vozes em Ajustes > Acessibilidade > Ler e Falar (ou Conteúdo Falado) > Vozes. O OpenClient atualiza esta lista automaticamente após o download de uma voz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica altre voci in Impostazioni > Accessibilità > Leggi e parla (o Contenuto letto ad alta voce) > Voci. OpenClient aggiorna automaticamente questo elenco dopo il download di una voce."
          }
        }
      }
    },
    "Enhanced": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprimorada"
          }
        },
        "it": {
