    "Agent changed" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Agent changed" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Agente modificato" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Agente alterado" } } } },
    "Collapsed" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Collapsed" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Compresso" } }, "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Recolhido" } } } },
