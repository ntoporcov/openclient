    "Automatic": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatico"
          }
        }
      }
    },
    "Automatic sends after silence. Hold to Talk sends when you release the sphere.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo Automático envia após o silêncio. Segure para falar envia quando você solta a esfera."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalità Automatico invia dopo il silenzio. Tieni premuto per parlare invia quando rilasci la sfera."
          }
        }
      }
    },
    "Hold Sending": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspender envio"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sospendi invio"
          }
        }
      }
    },
    "Input Mode": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo de entrada"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modalità di input"
          }
        }
      }
    },
    "Mute Microphone": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenciar microfone"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva microfono"
          }
        }
      }
    },
    "Prevents silence from sending the current message while continuing to listen.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Impede que o silêncio envie a mensagem atual enquanto continua escutando."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedisce al silenzio di inviare il messaggio attuale mentre continua l'ascolto."
          }
        }
      }
    },
    "Allow Personal Voice": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir Voz Pessoal"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti Voce personale"
          }
        }
      }
    },
    "Automatically prefers Premium, then Enhanced, then Standard.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefere automaticamente Premium, depois Aprimorada e, por fim, Padrão."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferisce automaticamente Premium, poi Migliorata e infine Standard."
          }
        }
      }
    },
    "BEST VALUE": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "MELHOR OFERTA"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MIGLIOR VALORE"
          }
        }
      }
    },
    "Buying Pro Lifetime does not cancel Pro Monthly. Cancel Pro Monthly to avoid future renewals.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprar o Pro Vitalício não cancela o Pro Mensal. Cancele o Pro Mensal para evitar futuras renovações."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acquisto di Pro a vita non annulla Pro mensile. Annulla Pro mensile per evitare rinnovi futuri."
          }
        }
      }
    },
    "Best Available": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Melhor disponível"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Migliore disponibile"
          }
        }
      }
    },
    "Best Available automatically uses the highest-quality installed voice for your language.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Melhor disponível usa automaticamente a voz instalada de maior qualidade para seu idioma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Migliore disponibile usa automaticamente la voce installata di qualità più alta per la tua lingua."
          }
        }
      }
    },
    "Lifetime": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitalício"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A vita"
          }
        }
      }
    },
    "Manage Pro Monthly": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerenciar Pro Mensal"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci Pro mensile"
          }
        }
      }
    },
    "Lifetime launch price increases September 30. The regular price is US$29.99 or the local equivalent.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O preço promocional vitalício aumenta em 30 de setembro. O preço normal é US$ 29,99 ou o equivalente local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prezzo promozionale a vita aumenta il 30 settembre. Il prezzo normale è 29,99 USD o l'equivalente locale."
          }
        }
      }
    },
    "Monthly": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensal"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensile"
          }
        }
      }
    },
    "Monthly subscriptions automatically renew unless canceled at least 24 hours before the end of the current period.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As assinaturas mensais são renovadas automaticamente, a menos que sejam canceladas pelo menos 24 horas antes do fim do período atual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli abbonamenti mensili si rinnovano automaticamente se non vengono annullati almeno 24 ore prima della fine del periodo corrente."
          }
        }
      }
    },
    "One-time purchase + Pro Life icon": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra única + ícone Pro Life"
