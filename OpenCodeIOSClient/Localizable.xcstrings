    "Project is no longer available. Open the app to sync widget settings.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O projeto não está mais disponível. Abra o aplicativo para sincronizar as configurações do widget."
          }
        },
