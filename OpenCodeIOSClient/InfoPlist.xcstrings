    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenClient connects to your OpenCode server and its device-tool bridge on your local network."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenClient si connette al tuo server OpenCode e al suo bridge degli strumenti del dispositivo sulla tua rete locale."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O OpenClient se conecta ao seu servidor OpenCode e à ponte de ferramentas do dispositivo pela rede local."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenClient uses the microphone for dictation and voice conversations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenClient usa il microfono per la dettatura e le conversazioni vocali."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O OpenClient usa o microfone para ditado e conversas por voz."
          }
        }
      }
    },
    "NSPersonalVoiceUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenClient uses your Personal Voice to read AI responses aloud when you select it."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenClient usa la tua Voce personale per leggere ad alta voce le risposte dell'IA quando la selezioni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O OpenClient usa sua Voz Pessoal para ler as respostas da IA em voz alta quando você a seleciona."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenClient uses your photo library to show recent photos and attach selected images to messages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenClient usa la tua libreria foto per mostrare foto recenti e allegare le immagini selezionate ai messaggi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O OpenClient usa sua fototeca para mostrar fotos recentes e anexar as imagens selecionadas às mensagens."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Privacy - Speech Recognition Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenClient uses speech recognition to transcribe dictation and voice conversations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenClient usa il riconoscimento vocale per trascrivere la dettatura e le conversazioni vocali."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O OpenClient usa o reconhecimento de fala para transcrever ditados e conversas por voz."
          }
        }
      }
    }
